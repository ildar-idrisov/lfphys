# Machine-specific settings of the visualization server; copy to .env in this folder (git-ignored) and edit.
# The port the server listens on (http://localhost:<port>/)
VIZ_PORT=8479
# CPU limit of the server's container (0 = no limit); keep the host's other jobs safe on a shared machine
VIZ_CPUS=0
# The user and group the server writes as: the owner of the clone (`id -u`, `id -g`); visualizations/runs/ is written
UID=1000
GID=1000
# Pin GPU 0 by its PCI bus id (nvidia-smi --query-gpu=pci.bus_id --format=csv); empty: no pin
LFPHYS_GPU_PCI=
